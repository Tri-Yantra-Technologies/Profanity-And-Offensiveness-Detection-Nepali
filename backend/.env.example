# Backend Environment Variables
# Copy this file to .env and adjust values

# CORS - Set to your production frontend URL
FRONTEND_ORIGIN=http://localhost:3000

# Model Configuration
# Local paths (relative to backend directory)
MODEL_PROFANITY_PATH=artifacts/profanity_model.pkl
MODEL_OFFENSIVENESS_PATH=artifacts/offensiveness_model.pkl

# Remote Model URLs (optional)
# If set, models will be downloaded at startup and cached locally
# MODEL_PROFANITY_URL=https://huggingface.co/your-repo/resolve/main/profanity_model.pkl
# MODEL_OFFENSIVENESS_URL=https://huggingface.co/your-repo/resolve/main/offensiveness_model.pkl

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
